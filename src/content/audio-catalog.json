    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/2": {
    "text": "Τέλεια!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/3": {
    "text": "Πολύ ωραία!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/4": {
    "text": "Τα κατάφερες!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/5": {
    "text": "Σούπερ!",
