    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/counted-on": {
    "text": "Ξεκίνησες από τον μεγαλύτερο. Πολύ καλή ιδέα!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/doubles": {
    "text": "Σκέφτηκες τα διπλά. Ωραίος τρόπος!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/kept-trying": {
    "text": "Το προσπάθησες ξανά και το βρήκες!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/looked-carefully": {
    "text": "Κοίταξες προσεκτικά. Μπράβο!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/made-ten": {
    "text": "Έκανες πρώτα δεκάδα, πολύ καλή ιδέα!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/near-doubles": {
    "text": "Βρήκες τα σχεδόν διπλά. Πολύ καλή σκέψη!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/no-counting": {
    "text": "Το είδες χωρίς να μετρήσεις ένα ένα!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/split-number": {
    "text": "Έσπασες τον αριθμό σε κομμάτια. Ωραίος τρόπος!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  },
  "praise/without-blocks": {
    "text": "Το βρήκες χωρίς τους κύβους!",
    "voice": "aTP4J5SJLQl74WTSRXKW",
    "model": "eleven_multilingual_v2",
    "format": "mp3_24000_48"
  }
}
